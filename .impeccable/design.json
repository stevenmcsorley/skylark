  "narrative": {
    "northStar": "The Field Log",
    "overview": "Skylark reads as a printed log book, not a dashboard. Cool grey-white paper carries white panels, text and primary actions are near-black ink, and ruled entries replace cards and tiles. Colour has jobs: vermilion only for what needs a person; amber and sky only as level dots; deep green only as resolved text. Flat, no gradients or shadows.",
    "keyCharacteristics": [
      "Paper, white panel, ink; no dark chrome, no side rail.",
      "Top text tabs with a 2px ink underline on one ruled bar.",
      "Hanken Grotesk only, tabular figures in tables.",
      "Quiet, scannable density: 14px body, 12px labels, 48px ledger rows.",
      "Real numbers only; empty states say so and show the next step."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Vermilion marks only what needs a person. If everything is red, nothing is.",
        "section": "colors"
      },
      {
        "name": "The Dot Rule",
        "body": "Level colour is a small solid dot beside a word, never a filled pill or a row tint.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numbers in tables (td) are tabular so columns of counts align.",
        "section": "typography"
      },
      {
        "name": "The Flat Rule",
        "body": "Surfaces carry no shadow at rest or on hover; separation is a 1px rule or a tonal step.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do open every page with a 24px title and one purpose sentence.",
      "Do use ink for primary actions and vermilion only for what needs a person.",
      "Do show level as an 8px dot plus the level word.",
      "Do keep surfaces flat with 1px rules; use radii of 6px or 8px.",
      "Do give every control the shared 2px ink focus outline.",
      "Do show real counts with the scale written out."
    ],
    "donts": [
      "Don't build a dark sidebar admin with KPI tiles or rainbow status colours.",
      "Don't use gradients or shadows for depth.",
      "Don't fill pills with level colour or tint rows by level.",
      "Don't use green for fills; resolved is text or a small mark.",
      "Don't add a second typeface or an accent hue beside ink."
    ]
  }
